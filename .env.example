# Server-side only. Used by POST /api/realtime/session to mint ephemeral
# xAI realtime tokens. Never expose this key in the browser or client bundles.
XAI_API_KEY=

# Server-side only. Neon/Postgres URL for Lexi memories + decay.
# Either name works. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# NEON_DATABASE_URL=

# Lovense Standard API (server). Developer token + your user uid.
# Official command host: https://api.lovense-api.com/api/lan/v2/command
# Optional LAN/Connect URL from the Lovense Remote/Connect app, e.g. https://127-0-0-1.lovense.club:30010/command
LOVENSE_TOKEN=
LOVENSE_UID=
LOVENSE_CONNECT_URL=

# Joyhub official partner/cloud API only. No public HTTP command API is published;
# paste the URL and token from Joyhub partner docs (business.joyhub.net).
# Never put these in the browser. Never commit real values.
JOYHUB_API_URL=
JOYHUB_TOKEN=
JOYHUB_DEVICE_ID=
