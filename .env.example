# Server-side only. Used by POST /api/realtime/session to mint ephemeral
# xAI realtime tokens, and by POST /api/generate/image and /api/generate/video
# for Grok Imagine. Never expose this key in the browser or client bundles.
XAI_API_KEY=

# Optional Grok Imagine model overrides (server-side only).
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Server-side only. Neon/Postgres URL for Lexi memories + decay.
# Either name works. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# NEON_DATABASE_URL=

# Lovense Standard API (server). Developer token + your user uid.
# Official command host: https://api.lovense-api.com/api/lan/v2/command
# Optional LAN/Connect URL from the Lovense Remote/Connect app, e.g. https://127-0-0-1.lovense.club:30010/command
LOVENSE_TOKEN=
LOVENSE_UID=
LOVENSE_CONNECT_URL=

# Joyhub official partner/cloud API only. No public HTTP command API is published;
# paste the URL and token from Joyhub partner docs (business.joyhub.net).
# Never put these in the browser. Never commit real values.
JOYHUB_API_URL=
JOYHUB_TOKEN=
JOYHUB_DEVICE_ID=

# Epic / Fortnite companion (server only). Never commit real values or .env.local.
# Lexi cannot run the game client. She can sign in, add TTBarleezy, join his party, and sit out.
# Ian creates or provides a real Lexi Epic account — do not invent an email or scrape signup.
#
# Preferred: fnbr-style device auth JSON (accountId, deviceId, secret). Empty placeholders:
EPIC_DEVICE_AUTH=
# EPIC_ACCOUNT_ID=
# EPIC_DEVICE_ID=
# EPIC_DEVICE_SECRET=
#
# One-shot login (exchange_code or authorization_code). After success the server may print
# a device-auth JSON to paste into EPIC_DEVICE_AUTH; then remove this code.
EPIC_EXCHANGE_CODE=
#
# Optional local email/password bootstrap (never commit real values). May hit captcha/2FA;
# if so, use the authorization-code link instead. Successful login writes EPIC_DEVICE_AUTH.
EPIC_EMAIL=
EPIC_PASSWORD=
EPIC_DISPLAY_NAME=
#
# Default friend target (Ian). Override only if the in-game name changes.
FORTNITE_FRIEND_DISPLAY_NAME=TTBarleezy
# Optional override of the public fortniteIOSGameClient used for device_auth (not a user password).
# EPIC_CLIENT_ID=
# EPIC_CLIENT_SECRET=

# Messaging channels (server only). Never commit real values.
# Same Lexi identity + Neon memory. Adults only. She only outbound-pings when Ian asked.
#
# Discord — REST DMs + Interactions. No persistent gateway on Vercel, so plain DM inbound
# will not arrive unless you host a gateway elsewhere. Slash commands work:
# set Interactions Endpoint URL to https://<host>/api/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
#
# Telegram — bot token + Ian's chat id. Inbound: POST /api/telegram/webhook
# setWebhook: https://api.telegram.org/bot<token>/setWebhook?url=https://<host>/api/telegram/webhook&secret_token=<secret>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
#
# SMS — Twilio. Inbound webhook: POST /api/sms/webhook (form-urlencoded).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
# TWILIO_WEBHOOK_URL=
#
# Email — Resend preferred, or SMTP. Inbound: POST /api/email/inbound
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# RESEND_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
#
# Generic inbound for Slack/WhatsApp later: POST /api/channels/inbound
CHANNELS_INBOUND_SECRET=
#
# Optional HTTP chat model for text channels (not the voice WebSocket).
# XAI_CHAT_MODEL=grok-4.6
