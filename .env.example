# Server-side only. Used by POST /api/realtime/session to mint ephemeral
# xAI realtime tokens, and by POST /api/generate/image and /api/generate/video
# for Grok Imagine. Never expose this key in the browser or client bundles.
XAI_API_KEY=

# Optional Grok Imagine model overrides (server-side only).
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Server-side only. Neon/Postgres URL for Lexi memories + decay.
# Either name works. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# NEON_DATABASE_URL=

# Lovense Standard API (server). Developer token + your user uid.
# Official command host: https://api.lovense-api.com/api/lan/v2/command
# Optional LAN/Connect URL from the Lovense Remote/Connect app, e.g. https://127-0-0-1.lovense.club:30010/command
LOVENSE_TOKEN=
LOVENSE_UID=
LOVENSE_CONNECT_URL=

# Joyhub official partner/cloud API only. No public HTTP command API is published;
# paste the URL and token from Joyhub partner docs (business.joyhub.net).
# Never put these in the browser. Never commit real values.
JOYHUB_API_URL=
JOYHUB_TOKEN=
JOYHUB_DEVICE_ID=

# Epic / Fortnite companion (server only). Never commit real values or .env.local.
# Lexi cannot run the game client. She can sign in, add TTBarleezy, join his party, and sit out.
# Ian creates or provides a real Lexi Epic account — do not invent an email or scrape signup.
#
# Preferred: fnbr-style device auth JSON (accountId, deviceId, secret). Empty placeholders:
EPIC_DEVICE_AUTH=
# EPIC_ACCOUNT_ID=
# EPIC_DEVICE_ID=
# EPIC_DEVICE_SECRET=
#
# One-shot login (exchange_code or authorization_code). Token requests use
# scope=basic_profile friends_list presence. After success the server may print
# a device-auth JSON to paste into EPIC_DEVICE_AUTH; then remove this code.
# If an older device auth was minted without those scopes, paste a new code once
# and re-run `node scripts/configure-fortnite.mjs` so device auth is reissued.
EPIC_EXCHANGE_CODE=
#
# Optional local email/password bootstrap (never commit real values). May hit captcha/2FA;
# if so, use the authorization-code link instead. Successful login writes EPIC_DEVICE_AUTH.
EPIC_EMAIL=
EPIC_PASSWORD=
EPIC_DISPLAY_NAME=
#
# Default friend target (Ian). Override only if the in-game name changes.
FORTNITE_FRIEND_DISPLAY_NAME=TTBarleezy
# fortnitepy sidecar (Friends lobby join). Default http://127.0.0.1:8765
# Start with `npm run fortnite:sidecar`. Optional shared token; localhost only.
# FORTNITEPY_SIDECAR_URL=http://127.0.0.1:8765
# FORTNITEPY_SIDECAR_TOKEN=
# FORTNITEPY_AUTOSTART=1
# Optional override of the public fortniteIOSGameClient used for device_auth (not a user password).
# EPIC_CLIENT_ID=
# EPIC_CLIENT_SECRET=

# Messaging channels (server only). Never commit real values.
# Same Lexi identity + Neon memory. Adults only. She only outbound-pings when Ian asked.
#
# Discord — REST DMs + Interactions. No persistent gateway on Vercel, so plain DM inbound
# will not arrive unless you host a gateway elsewhere. Slash commands work:
# set Interactions Endpoint URL to https://<host>/api/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
#
# Telegram — bot token + Ian's chat id. Inbound: POST /api/telegram/webhook
# setWebhook: https://api.telegram.org/bot<token>/setWebhook?url=https://<host>/api/telegram/webhook&secret_token=<secret>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
#
# SMS — Twilio. Inbound webhook: POST /api/sms/webhook (form-urlencoded).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
# TWILIO_WEBHOOK_URL=
#
# Email — Resend preferred, or SMTP. Inbound: POST /api/email/inbound
# Password reset also uses this outbound mailer. EMAIL_TO is the channel inbox
# (Ian). Reset links are sent to the address stored on the account.
# Need EMAIL_FROM plus RESEND_API_KEY or SMTP_HOST + SMTP_USER + SMTP_PASS.
# Optional public origin for reset links (defaults to the request origin):
# APP_URL=https://talktolexi.app
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# RESEND_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
#
# Generic inbound for Slack/WhatsApp later: POST /api/channels/inbound
CHANNELS_INBOUND_SECRET=
#
# Optional HTTP chat model for text channels (not the voice WebSocket).
# XAI_CHAT_MODEL=grok-4.6

# Apple Music / MusicKit (server only). Never commit the .p8 key or .env.local.
# Create a MusicKit identifier + MusicKit private key in Apple Developer.
# Ian taps Connect Apple Music and signs in; the user token is an HttpOnly cookie.
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY=
# Optional storefront (default us):
# APPLE_MUSIC_STOREFRONT=us

# PlayStation Network identity for PS5 party-chat routing (server + iOS settings).
# Backup account Online ID. Not a Sony password. Never commit NPSSO / access tokens.
PSN_LOGIN_NAME=barleezyfbaby
PSN_ONLINE_ID=Barleezybaby
PSN_ACCOUNT_NAME=Barleezybaby
# PSN_TOKEN_ACCOUNT=Barleezybaby
# One-shot Sony cookie from ca.account.sony.com (Account Management → NPSSO).
# After pasting, run: node --experimental-strip-types scripts/configure-psn.mjs
# PSN_NPSSO=
# PSN_ACCESS_TOKEN=
# PSN_REFRESH_TOKEN=

# Optional HMAC secret for the native iPhone app (ASWebAuthenticationSession).
# Used by POST /api/ios/auth and verified on POST /api/ios/session.
# Falls back to XAI_API_KEY if unset. Never put this in the iOS bundle.
# IOS_SESSION_SECRET=

# Optional one-time admin password seed (Barleezy / Ian). Never commit the real value.
# ADMIN_BOOTSTRAP_PASSWORD=

